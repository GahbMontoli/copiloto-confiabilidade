<Window x:Class="AssistentePatinho.App.FileAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Análise local de arquivo" Width="860" Height="720"
        MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="#F4F6F8" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="AnalysisButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#DDE7FF"/>
            <Setter Property="Foreground" Value="#243D76"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="16" Padding="18" BorderBrush="#E1E5EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ANÁLISE LOCAL DE ENGENHARIA" FontSize="11" FontWeight="Bold" Foreground="#52627A"/>
                    <TextBlock Text="Inspeção rastreável, offline e somente leitura" FontSize="22" FontWeight="Bold" Foreground="#172033" Margin="0,5,0,0"/>
                    <TextBlock Text="O arquivo não é alterado nem enviado para a internet. Os achados são derivados de regras versionadas." Foreground="#667085" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#E9F5F0" CornerRadius="12" Padding="12,7" VerticalAlignment="Top" Margin="14,0,0,0">
                    <TextBlock x:Name="CacheStatusText" Text="AGUARDANDO" FontSize="10" FontWeight="Bold" Foreground="#087A4B"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="16" Margin="0,12,0,0" BorderBrush="#E1E5EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="ARQUIVO" FontSize="10" FontWeight="Bold" Foreground="#667085" Margin="2,0,0,5"/>
                    <TextBox x:Name="FilePathTextBox" Padding="10,8" Background="#F8F9FB" BorderBrush="#D6DAE1"
                             ToolTip="Selecione ou cole o caminho de um arquivo CSV, JSON, LOG ou TXT. Pressione Enter para analisar."
                             TextChanged="FilePathTextBox_TextChanged" KeyDown="FilePathTextBox_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CLASSE DA FONTE" FontSize="10" FontWeight="Bold" Foreground="#667085" Margin="2,0,0,5"/>
                    <ComboBox x:Name="EvidenceClassSelector" SelectedIndex="0" Padding="9,7" Background="White" BorderBrush="#D6DAE1">
                        <ComboBoxItem Content="Não declarada"/>
                        <ComboBoxItem Content="synthetic"/>
                        <ComboBoxItem Content="official_raw"/>
                        <ComboBoxItem Content="lab_observed"/>
                        <ComboBoxItem Content="field_observed"/>
                        <ComboBoxItem Content="derived"/>
                    </ComboBox>
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,13,0,0">
                    <Button Content="_Selecionar arquivo" ToolTip="Selecionar arquivo (Alt+S)" Click="SelectFile_Click" Style="{StaticResource AnalysisButton}"/>
                    <Button x:Name="RunAnalysisButton" Content="_Executar análise" ToolTip="Executar análise (Alt+E)" Click="RunAnalysis_Click" IsEnabled="False" Background="#D9F4E7" Foreground="#075C39" Style="{StaticResource AnalysisButton}"/>
                    <TextBlock x:Name="AnalysisStatusText" Text="Selecione ou cole um caminho local." Foreground="#667085" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#EEF2FF" CornerRadius="16" Padding="15" Margin="0,12,0,0" BorderBrush="#DCE3F7" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="RESUMO" FontSize="10" FontWeight="Bold" Foreground="#4C5A88"/>
                    <TextBlock x:Name="FindingCountText" DockPanel.Dock="Right" Text="0 achados" FontSize="10" FontWeight="Bold" Foreground="#4C5A88"/>
                </DockPanel>
                <TextBlock x:Name="SummaryText" Text="O resumo aparecerá após a análise." FontSize="15" FontWeight="SemiBold" Foreground="#172033" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="SourceMetadataText" Foreground="#596579" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="ChecksumText" FontFamily="Consolas" FontSize="10" Foreground="#667085" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl x:Name="FindingItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="13" Padding="14" Margin="0,0,0,9" BorderBrush="#E1E5EB" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Background="#FFF3D6" CornerRadius="8" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" Foreground="#7A5600"/>
                                        </Border>
                                        <TextBlock Text="{Binding Rule}" FontSize="11" FontWeight="Bold" Foreground="#465266" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Location}" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="10" Foreground="#7C8799" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Message}" FontSize="15" FontWeight="SemiBold" Foreground="#172033" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Evidence}" Foreground="#596579" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Verification}" Foreground="#087A4B" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Limitation}" FontSize="11" FontStyle="Italic" Foreground="#7C8799" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="EmptyFindingsPanel" Background="White" CornerRadius="13" BorderBrush="#E1E5EB" BorderThickness="1" Visibility="Visible">
                <TextBlock x:Name="EmptyFindingsText" Text="Os achados aparecerão aqui." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7C8799"/>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#FFF7DF" CornerRadius="13" Padding="13" Margin="0,12,0,0">
            <TextBlock x:Name="InterpretationLimitText" Text="A análise não substitui inspeção, medição ou validação técnica." FontSize="11" FontStyle="Italic" Foreground="#6E5A25" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>

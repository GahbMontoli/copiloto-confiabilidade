<Window x:Class="AssistentePatinho.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AssistentePatinho.App"
        Title="Copiloto de Confiabilidade" Width="640" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Storyboard x:Key="DuckIdle" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="DuckFloatTransform" Storyboard.TargetProperty="Y" From="0" To="-7" Duration="0:0:1.5"/>
            <DoubleAnimation Storyboard.TargetName="DuckRotateTransform" Storyboard.TargetProperty="Angle" From="-1" To="1" Duration="0:0:1.5"/>
        </Storyboard>
        <Storyboard x:Key="DuckClick">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DuckScaleTransform" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/><EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="0.92"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1.08"/><EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DuckScaleTransform" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/><EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.08"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="0.94"/><EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="DuckAlert">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DuckShakeTransform" Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/><EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="-7"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="7"/><EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="-5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="5"/><EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#FFF0B8"/>
            <Setter Property="Foreground" Value="#33240B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Selector" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6DAE1"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="PanelCard" Width="590" MaxHeight="620" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#FCFFFFFF" BorderBrush="#18A56B00" BorderThickness="1" CornerRadius="26" Padding="22" Visibility="Collapsed">
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.24" Color="#0F172A"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="#FFF0B8" Margin="0,0,12,0">
                        <TextBlock Text="CM" FontWeight="Bold" FontSize="14" Foreground="#6C4D00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Copiloto de Confiabilidade" FontSize="21" FontWeight="Bold" Foreground="#172033"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#22A06B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectorStatusText" Text="Carregando CMMS simulado..." FontSize="12" Foreground="#667085"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Content="×" Width="36" Height="36" FontSize="20" Background="#EEF1F5" Foreground="#475467"
                            Style="{StaticResource ActionButton}" Padding="0" Margin="0" Click="ClosePanel_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ATIVO" FontSize="10" FontWeight="Bold" Foreground="#667085" Margin="2,0,0,5"/>
                        <ComboBox x:Name="AssetSelector" Style="{StaticResource Selector}" DisplayMemberPath="DisplayName" SelectionChanged="AssetSelector_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ORDEM / CASO" FontSize="10" FontWeight="Bold" Foreground="#667085" Margin="2,0,0,5"/>
                        <ComboBox x:Name="WorkOrderSelector" Style="{StaticResource Selector}" DisplayMemberPath="DisplayName" SelectionChanged="WorkOrderSelector_SelectionChanged"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="#FFF7DF" CornerRadius="13" Padding="12" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="HISTÓRICO" FontSize="9" FontWeight="Bold" Foreground="#8A6500"/><TextBlock x:Name="HistoryCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#5C4509"/><TextBlock Text="ordens concluídas" FontSize="10" Foreground="#7B6A3C"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#FCECEB" CornerRadius="13" Padding="12" Margin="4,0">
                        <StackPanel><TextBlock Text="RECORRÊNCIA" FontSize="9" FontWeight="Bold" Foreground="#A2392E"/><TextBlock x:Name="RecurrenceText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#7D2820"/><TextBlock Text="mesma falha" FontSize="10" Foreground="#8D514B"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#E9F5F0" CornerRadius="13" Padding="12" Margin="8,0,0,0">
                        <StackPanel><TextBlock Text="CASOS SIMILARES" FontSize="9" FontWeight="Bold" Foreground="#087A4B"/><TextBlock x:Name="SimilarCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#075C39"/><TextBlock Text="resultados úteis" FontSize="10" Foreground="#39705A"/></StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <Border Background="#EEF2FF" CornerRadius="16" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel><TextBlock Text="CASO SELECIONADO" FontSize="10" FontWeight="Bold" Foreground="#4C5A88"/><TextBlock x:Name="PriorityText" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold" Foreground="#A2392E"/></DockPanel>
                                <TextBlock x:Name="CaseTitleText" Text="Selecione uma ordem" FontSize="17" FontWeight="Bold" Foreground="#172033" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AssetDetailsText" Foreground="#667085" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CaseSummaryText" Foreground="#4C5A88" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="EVIDÊNCIAS UTILIZADAS" FontSize="10" FontWeight="Bold" Foreground="#667085" Margin="2,3,0,5"/>
                        <ItemsControl x:Name="EvidenceItems" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="•" Foreground="#D69A00" Margin="0,0,7,0"/><TextBlock Text="{Binding}" Foreground="#596579" TextWrapping="Wrap"/>
                            </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="CASOS SEMELHANTES" FontSize="10" FontWeight="Bold" Foreground="#667085" Margin="2,3,0,5"/>
                        <ItemsControl x:Name="SimilarCaseItems" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="#F5F6F8" CornerRadius="11" Padding="11" Margin="0,0,0,7">
                                    <TextBlock Text="{Binding DisplaySummary}" Foreground="#465266" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#ECF8F2" CornerRadius="14" Padding="14">
                            <StackPanel><TextBlock Text="VERIFICAÇÕES RECOMENDADAS" FontSize="10" FontWeight="Bold" Foreground="#087A4B"/>
                                <ItemsControl x:Name="CheckItems" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="✓" Foreground="#087A4B" FontWeight="Bold" Margin="0,0,7,0"/><TextBlock Text="{Binding}" Foreground="#39594A" TextWrapping="Wrap"/>
                                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="LimitationsText" Margin="2,10,2,0" FontSize="11" FontStyle="Italic" Foreground="#7C8799" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <WrapPanel Grid.Row="4" Margin="0,15,0,0">
                    <Button x:Name="AnalyzeButton" Content="✦ Gerar triagem" Click="Analyze_Click" Background="#D9F4E7" Foreground="#075C39" Style="{StaticResource ActionButton}"/>
                    <Button Content="⚡ Simular nova falha" Click="Simulate_Click" Style="{StaticResource ActionButton}"/>
                    <Button Content="Limpar" Click="Clear_Click" Background="#EEF1F5" Style="{StaticResource ActionButton}"/>
                    <Button Content="Sair" Click="Exit_Click" Background="#FDECEC" Foreground="#9B1C1C" Style="{StaticResource ActionButton}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Width="185" Height="190" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,2,0">
            <Grid.RenderTransform><TransformGroup>
                <ScaleTransform x:Name="DuckScaleTransform" ScaleX="1" ScaleY="1" CenterX="92" CenterY="150"/>
                <RotateTransform x:Name="DuckRotateTransform" CenterX="92" CenterY="150"/>
                <TranslateTransform x:Name="DuckFloatTransform"/><TranslateTransform x:Name="DuckShakeTransform"/>
            </TransformGroup></Grid.RenderTransform>
            <Border x:Name="SpeechBubble" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="170" Background="#FCFFFFFF"
                    BorderBrush="#E7D8A3" BorderThickness="1" CornerRadius="13" Padding="12,8" Visibility="Collapsed">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.2"/></Border.Effect>
                <TextBlock x:Name="DuckSpeechText" Text="Pronto para consultar o CMMS." FontSize="12" FontWeight="SemiBold" Foreground="#4A3A14" TextWrapping="Wrap"/>
            </Border>
            <Grid x:Name="DuckButton" Width="150" Height="140" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                  MouseLeftButtonUp="DuckButton_MouseLeftButtonUp" MouseRightButtonUp="DuckButton_MouseRightButtonUp">
                <Grid.RenderTransform><ScaleTransform x:Name="DuckFacingTransform" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                <Grid.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="6" Opacity="0.32" Color="#352600"/></Grid.Effect>
                <local:Duck3DView x:Name="DuckModel" Width="150" Height="140"/>
                <Rectangle Width="85" Height="34" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DuckHead_MouseLeftButtonDown"/>
                <Border x:Name="AlertBadge" Width="35" Height="35" CornerRadius="18" Background="#D92D20" BorderBrush="White" BorderThickness="3"
                        Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,2,0">
                    <TextBlock Text="!" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="20" Foreground="White"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
